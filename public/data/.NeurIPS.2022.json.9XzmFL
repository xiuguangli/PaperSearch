            "order": 360,
            "original_url": "https://openreview.net/forum?id=QXiYW3TrgXj",
            "title": "On the Learning Mechanisms in Physical Reasoning",
            "pdf_url": "https://openreview.net/pdf?id=QXiYW3TrgXj",
            "authors": [
                "Shiqian Li",
                "Kewen Wu",
