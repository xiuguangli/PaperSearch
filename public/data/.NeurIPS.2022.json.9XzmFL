            "order": 149,
            "original_url": "https://openreview.net/forum?id=uP9RiC4uVcR",
            "title": "When to Make Exceptions: Exploring Language Models as Accounts of Human Moral Judgment",
            "pdf_url": "https://openreview.net/pdf?id=uP9RiC4uVcR",
            "authors": [
                "Zhijing Jin",
                "Sydney Levine",
                "Fernando Gonzalez Adauto",
                "Ojasv Kamal",
                "Maarten Sap",
                "Mrinmaya Sachan",
